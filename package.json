{
  "name": "@chatlychat/widget-element",
  "version": "0.18.0",
  "description": "The Chatly chat widget as a custom element (<chatly-widget>), plus the embed lifecycle framework wrappers share. Zero dependencies.",
  "license": "MIT",
  "homepage": "https://github.com/chatlychat/chatly-widget-element#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chatlychat/chatly-widget-element.git"
  },
  "bugs": {
    "url": "https://github.com/chatlychat/chatly-widget-element/issues"
  },
  "keywords": [
    "chatly",
    "chat",
    "widget",
    "custom-element",
    "web-component",
    "support"
  ],
  "author": "Chatly",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/register.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}
